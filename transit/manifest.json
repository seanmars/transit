{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.3",
  "description": "__MSG_extDescription__",
  "default_locale": "zh_TW",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://generativelanguage.googleapis.com/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content-youtube-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-fw-detect-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://youtube.googleapis.com/*"
      ],
      "js": [
        "content-drive-iframe.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-ns.js",
        "lib/i18n-content.js",
        "lib/shortcut-utils.js",
        "lib/format-currency.js",
        "lib/domain-utils.js",
        "lib/edit-link-repair.js",
        "content-toast.js",
        "content-detect.js",
        "content-serialize.js",
        "content-inject.js",
        "content-spa.js",
        "content-youtube.js",
        "content-drive.js",
        "content-x.js",
        "content.js",
        "content-shortcuts.js",
        "content-hover.js",
        "content-floating-icon.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "translate-doc/*",
        "lib/vendor/pdfjs/*",
        "lib/vendor/pdf-lib/*",
        "lib/vendor/fonts/*",
        "icons/icon-48.png",
        "popup/popup.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "translate-preset-0": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "__MSG_cmdTranslateMain__"
    }
  }
}
