{
  "name": "transit",
  "private": true,
  "description": "Transit Chrome 擴充功能的開發工具與測試",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "check": "node tools/build/check.mjs",
    "i18n:content": "node tools/build/generate-i18n-content.mjs",
    "i18n:check": "node tools/build/generate-i18n-content.mjs --check",
    "zh-charsets": "node tools/build/generate-zh-char-sets.mjs",
    "icons": "node tools/build/generate-icons.mjs",
    "release": "bash tools/release/release.sh",
    "release:ps": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/release/release.ps1",
    "test": "playwright test && jest --config jest.config.cjs",
    "test:regression": "playwright test test/regression/",
    "test:unit": "playwright test test/unit/",
    "test:version": "playwright test test/version-check.spec.js",
    "test:jest": "jest --config jest.config.cjs",
    "test:all": "playwright test && jest --config jest.config.cjs",
    "debug": "node tools/harness/debug-harness.js",
    "pdf-layout": "node tools/harness/pdf-layout-harness.js",
    "pdf-snapshot": "node tools/harness/pdf-layout-snapshot.js",
    "pdf-snapshot:update": "node tools/harness/pdf-layout-snapshot.js --update",
    "pdf-snapshot:metrics": "node tools/harness/pdf-layout-snapshot.js --metrics",
    "pdf-verify": "node tools/harness/pdf-verify-harness.js",
    "pdf-structure-verify": "node tools/harness/pdf-structure-verify.js",
    "docx-verify": "node tools/harness/docx-verify-harness.js",
    "pdf-corpus": "node tools/harness/pdf-corpus-verify.mjs",
    "pdf-corpus:fetch": "node tools/harness/pdf-corpus-fetch.mjs",
    "pdf-corpus:index": "node tools/harness/pdf-corpus-index.mjs",
    "pdf-corpus:pick": "node tools/harness/pdf-corpus-index.mjs --pick",
    "pdf-corpus:visual": "node tools/harness/pdf-visual-diff.mjs",
    "pdf-synth": "node test/tools/pdf-synth-fixtures.mjs"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.48.0",
    "jest": "^29.7.0",
    "jsdom": "^25.0.1",
    "pdf-lib": "^1.17.1",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0"
  }
}
